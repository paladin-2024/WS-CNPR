# Docker Compose environment file.
#
# Usage: cp .env.docker.example .env   (then fill in real values below)
# .env is git-ignored — never commit it. docker-compose.yml reads it via
# env_file: for the `app` and `db` services, and Docker Compose also uses it
# automatically for ${VAR} substitution inside docker-compose.yml itself
# (e.g. POSTGRES_DB: ${DB_DATABASE}) because it's named exactly ".env" in the
# project root.
#
# This is distinct from .env.example at the repo root, which targets a
# bare-metal/local install talking to a Postgres on 127.0.0.1. The one
# difference that matters here: DB_HOST must be the Compose *service* name
# ("db"), not localhost/127.0.0.1 — containers reach each other by service
# name on the compose network, not via the host's loopback interface. DB_PORT
# is Postgres's default port *inside its own container* (5432); it has
# nothing to do with whatever host port you might separately expose db on.

APP_ENV=production

# PostgreSQL connection — read by config/database.php via app/Core/Env.php,
# and also used to configure the `db` service itself (POSTGRES_DB/
# POSTGRES_USER/POSTGRES_PASSWORD in docker-compose.yml) so there is a single
# source of truth for credentials.
DB_HOST=db
DB_PORT=5432
DB_DATABASE=min_transport
DB_USERNAME=transport_app
DB_PASSWORD=REPLACE_WITH_A_REAL_PASSWORD

# Dream Digital SMS API (https://api2.dream-digital.info) — see
# app/Core/SmsService.php. Leave SMS_API_ID/SMS_API_PASSWORD blank to have
# SmsService::envoyer() fail closed (it logs and returns false rather than
# silently using a real default) if SMS sending isn't needed yet.
SMS_API_ID=
SMS_API_PASSWORD=
SMS_SENDER_ID=CNPR-TSHOPO
SMS_DEBUG=false
