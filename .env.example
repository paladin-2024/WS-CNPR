# Copy this file to .env and fill in real values. .env is git-ignored.

APP_ENV=local

# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=min_transport
DB_USERNAME=transport_app
DB_PASSWORD=

# Africala SMS API (SendSmsV2, https://api2.smsala.com) — single-token auth
SMS_API_TOKEN=
SMS_SENDER_ID=CNPR-TSHOPO
SMS_DEBUG=true

# Shared secret for e-taxe-kisangani's quittance.info portal calling this
# app's GET /api/verification/{id} server-to-server. Must match CNPR_API_KEY
# on that side. Empty = refuse all requests to that route (fail-closed).
CNPR_VERIFICATION_API_KEY=
