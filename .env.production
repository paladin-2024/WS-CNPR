# Production environment for cnpr.wscsarl.info
# Copy to .env and fill in ALL values before deploying

APP_ENV=production

# GitHub Container Registry (for pre-built app image)
# GHCR_OWNER=your_github_username  # or org name; default: paladin-2024

# PostgreSQL connection (use strong password!)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=min_transport
DB_USERNAME=transport_app
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Dream Digital SMS API (https://api2.dream-digital.info)
SMS_API_ID=your_sms_api_id
SMS_API_PASSWORD=your_sms_api_password
SMS_SENDER_ID=CNPR-TSHOPO
SMS_DEBUG=false

# Optional: Custom PHP settings
# PHP_MEMORY_LIMIT=256M
# PHP_MAX_EXECUTION_TIME=300
# PHP_UPLOAD_MAX_FILESIZE=10M
# PHP_POST_MAX_SIZE=10M